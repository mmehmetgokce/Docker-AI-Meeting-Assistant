    {
      "parameters": {
        "jsCode": "// AI çıktısını standart formatta döndür (chat API formatı)\nconst aiResponse = $input.first().json;\nconst inputData = $('Normalize Input Data').item.json;\n\n// Chat API: yanıt message.content içinde gelir\nlet rawResult = '';\nif (aiResponse.message && aiResponse.message.content) {\n  rawResult = aiResponse.message.content;\n} else if (aiResponse.response) {\n  rawResult = aiResponse.response;\n}\n\n// Sunucu tarafı temizlik: echoed notlar bloğunu sıyır\nrawResult = rawResult.replace(/<think>[\\s\\S]*?<\\/think>/gi, '');\nif (rawResult.toLowerCase().includes('<notlar>')) {\n  rawResult = rawResult.split(/<notlar>/i)[0];\n}\nrawResult = rawResult.replace(/<\\/notlar>/gi, '');\nrawResult = rawResult.trim();\n\nreturn [{\n  json: {\n    success: true,\n    taskType: inputData.taskType || 'unknown',\n    result: rawResult,\n    source: 'n8n Workflow Engine',\n    model: aiResponse.model || 'llama3.2',\n    processingTime: aiResponse.total_duration || null\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 400]
    },
