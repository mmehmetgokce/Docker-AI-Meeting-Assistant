      "id": "webhook-email",
      "name": "Webhook - Email Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 1150]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst title = body.title || 'Toplantı Raporu';\nconst recipient = body.recipient || 'Belirtilmedi';\nconst summary = body.summary || 'Özet bulunmuyor.';\nconst execSummary = body.executive_summary || '';\nconst tasks = Array.isArray(body.tasks) ? body.tasks : [];\nconst risks = Array.isArray(body.risks) ? body.risks : [];\n\nlet tasksHtml = tasks.map(t => `<li><strong>${t.task_description || t.description || ''}</strong> - Sorumlu: ${t.assignee || 'Atanmadı'} (${t.status || 'Yapılacak'})</li>`).join('');\nlet risksHtml = risks.map(r => `<li><strong>${r.risk_description || r.description || ''}</strong> (Etki: ${r.impact_level || 'Orta'}) - Önlem: ${r.mitigation_plan || '-'}</li>`).join('');\n\nconst htmlContent = `\n  <div style=\"font-family: Arial, sans-serif; padding: 20px; color: #333; max-width: 600px; border: 1px solid #e2e8f0; border-radius: 10px;\">\n    <h2 style=\"color: #2563eb; border-bottom: 2px solid #2563eb; padding-bottom: 10px;\">📌 ${title}</h2>\n    <p><strong>Alıcı:</strong> ${recipient}</p>\n    <h3>📝 Toplantı Özeti</h3>\n    <p style=\"background: #f8fafc; padding: 12px; border-radius: 6px;\">${summary}</p>\n    ${execSummary ? `<h3>👔 Yönetici Özeti</h3><p style=\"background: #f1f5f9; padding: 12px; border-radius: 6px;\">${execSummary}</p>` : ''}\n    <h3>📋 Görevler (${tasks.length})</h3>\n    <ul>${tasksHtml || '<li>Görev bulunmuyor.</li>'}</ul>\n    <h3>⚠️ Risk Analizi (${risks.length})</h3>\n    <ul>${risksHtml || '<li>Risk bulunmuyor.</li>'}</ul>\n    <hr style=\"margin-top: 20px; border: 0; border-top: 1px solid #e2e8f0;\">\n    <p style=\"font-size: 12px; color: #64748b;\">Bu e-posta AI Meeting Assistant n8n Otomasyon Akışı tarafından otomatik gönderilmiştir.</p>\n  </div>\n`;\n\nreturn [{\n  json: {\n    success: true,\n    recipient,\n    title,\n    subject: `[Toplantı Raporu] ${title}`,\n    html: htmlContent,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "format-email-html",
      "name": "Format Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
