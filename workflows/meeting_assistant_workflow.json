    {
      "parameters": {
        "jsCode": "// Extract body data - handles both webhook v1 ($json.body) and v2 ($json) formats\nconst body = $json.body || $json;\nreturn [{\n  json: {\n    taskType: body.taskType || 'summarize',\n    text: body.text || '',\n    title: body.title || '',\n    systemPrompt: body.systemPrompt || 'Toplantı notlarını özetle.'\n  }\n}];"
      },
      "id": "normalize-input",
      "name": "Normalize Input Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": ""
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.taskType }}",
                    "rightValue": "summarize",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Özet"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": ""
                },
                "conditions": [
